APP_ENV=development

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LLM_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
# Agent 4 Phase 2: explicitly choose a JSON-schema-capable model for the provider.
# Blank model/key uses deterministic fallback. Phase 1 never calls a provider.
# OpenAI uses Responses; Gemini uses generateContent. No automatic model substitution.
# Runtime limits live in Agent 4 ProviderConfig: 20s, 4000 output tokens, 128KB response.
LLM_MODEL=

PROPERTY_DATASET_PATH=
CLEANED_DATASET_PATH=

DEVELOPMENT_SAMPLE_SIZE=10000
GIT_SAMPLE_SIZE=500
RANDOM_SEED=42

